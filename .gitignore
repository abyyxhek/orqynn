# Rust build artifacts.
/target
/target*/
**/*.rs.bk

# Cargo lockfile is committed for a binary/workspace; uncomment if publishing
# libraries individually and you want the old convention.
#Cargo.lock

# IDE and editor state.
.vscode/
.idea/
*.iml
*.swp
*.swo

# Local environment and OS cruft.
.env
.env.*
.DS_Store
Thumbs.db

# Redirected target directory used to dodge OneDrive sync locks (see README).
.director-brain-target/

# Local scratch: build/test logs, generated audit workbooks, and source
# snapshots kept beside a file while it is being edited. None of this belongs in
# the history; the audit reports themselves are markdown and are tracked.
*.txt
*.xlsx
*.bak
*.original
